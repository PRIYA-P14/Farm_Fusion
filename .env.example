# Application
APP_NAME=AgriVerse-AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# OpenAI
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_MODEL=gpt-4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agriverse_db

# Weather API
WEATHER_API_KEY=<your_weather_api_key>
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Market API
MARKET_API_KEY=<your_market_api_key>
MARKET_API_URL=<your_market_api_url>

# Government API
GOVT_API_KEY=<your_govt_api_key>
GOVT_API_URL=<your_govt_api_url>

# Vector Store
CHROMA_PERSIST_DIR=./database/vector_store

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agriverse.log

# Security
SECRET_KEY=<your_secret_key>
ACCESS_TOKEN_EXPIRE_MINUTES=30
